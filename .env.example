# 复制这个文件并改名为 .env，再填上你的 API Key

# 用哪家大模型：qwen（千问） | deepseek | doubao（豆包） | mock（不联网的演示）
PROVIDER=qwen

# 千问：在阿里云百炼控制台创建 API Key
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 豆包（火山方舟）：DOUBAO_MODEL 填模型名称或接入点 ID
ARK_API_KEY=
DOUBAO_MODEL=

PORT=5178

# 大模型怎么写：song = 大模型当制作人写整首歌（默认）；loop = 只写 4 小节，其余由本地引擎展开
ARRANGE_MODE=song
# 整首模式下的轮数：2 = 初稿 + 挑剔制作人修改（默认，约 1–2 分钟）；1 = 只写初稿（更快、更省）
ARRANGE_PASSES=2

# ===== 公开部署时才需要（本机自己用可以不填）=====
# 只监听本机，让 Nginx 转发进来
# HOST=127.0.0.1
# 经过 Nginx 转发时设为 1，才能拿到访客的真实 IP
# TRUST_PROXY=1
# 每个 IP 每天最多用几次大模型生成（0 = 不限），全站每天最多几次
# RATE_LIMIT_PER_IP=10
# RATE_LIMIT_PER_DAY=300
# 同时最多几个大模型请求在跑
# MAX_CONCURRENT=4
# 只接受来自你域名的请求（多个用逗号分隔）
# ALLOWED_ORIGIN=https://你的域名
# 备案号，会显示在网页底部并链接到工信部网站（在中国内地服务器上公开时必须显示）
# ICP_NUMBER=X ICP备XXXXXXXX号-1
# 公安备案号（网站上线后 30 天内去全国互联网安全管理服务平台办理，办好后填这里）
# POLICE_NUMBER=

# 评测脚本（eval/run.mjs）用的口令：至少 16 位随机字符。带上它的请求不受"每个 IP 每天几次"的限制
# EVAL_TOKEN=
