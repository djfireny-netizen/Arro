# Copy this file to .env, then enter your API credentials locally.

# Model provider: aihubmix (Claude) | qwen | deepseek | doubao | mock
PROVIDER=aihubmix

# AIHubMix model API key (not the account management Access Key).
AIHUBMIX_API_KEY=
AIHUBMIX_MODEL=claude-opus-5-5
# Producer/reviewer system prompts; listener-facing output remains Chinese.
PROMPT_LANGUAGE=en

# Qwen: create an API key in Alibaba Cloud Model Studio.
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Doubao (Volcengine Ark): set DOUBAO_MODEL to a model name or endpoint ID.
ARK_API_KEY=
DOUBAO_MODEL=

PORT=5178

# Arrangement mode: song = model-produced full song (default);
# loop = a four-bar plan expanded by the local engine.
ARRANGE_MODE=song
# Full-song passes: 1 = draft only (default); technical validation/repair stays enabled.
# Music revision is optional via the studio button. Set 2 for legacy automatic review.
ARRANGE_PASSES=1

# ===== Public deployment settings (optional for local use) =====
# Bind to localhost and let Nginx proxy incoming requests.
# HOST=127.0.0.1
# Set to 1 behind a trusted Nginx proxy to use the visitor's real IP.
# TRUST_PROXY=1
# Daily generation limits per IP and across the site (0 = unlimited).
# RATE_LIMIT_PER_IP=10
# RATE_LIMIT_PER_DAY=300
# Maximum simultaneous model generation jobs.
# MAX_CONCURRENT=4
# Allowed request origins, separated by commas.
# ALLOWED_ORIGIN=https://music.example.com
# ICP registration text displayed in the footer for mainland China deployments.
# Enter the exact registration text issued to your website.
# ICP_NUMBER=
# Public security registration number displayed in the footer.
# POLICE_NUMBER=
# Invitation codes, separated by commas. Enter actual codes only in .env.
# INVITE_CODES=

# Evaluation credential used by eval/run.mjs: at least 16 random characters.
# Evaluation bypasses the per-IP daily limit; site-wide limits still apply.
# EVAL_TOKEN=
