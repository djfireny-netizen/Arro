# 放到 /etc/systemd/system/shiyin.service
# 然后：sudo systemctl daemon-reload && sudo systemctl enable --now shiyin
[Unit]
Description=Shiyin arrangement server
After=network.target

[Service]
Type=simple
# 改成你放代码的目录和运行用户
WorkingDirectory=/srv/shiyin
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=3
User=www-data
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
