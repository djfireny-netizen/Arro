# Install as /etc/systemd/system/shiyin.service.
# Then run: sudo systemctl daemon-reload && sudo systemctl enable --now shiyin
[Unit]
Description=Shiyin arrangement server
After=network.target

[Service]
Type=simple
# Set the working directory and service user for your deployment.
WorkingDirectory=/srv/shiyin
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=3
User=www-data
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
